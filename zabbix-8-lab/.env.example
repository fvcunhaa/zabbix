# Zabbix source snapshot
ZABBIX_SOURCE_URL=https://cdn.zabbix.com/zabbix/nightly/pre-zabbix-8.0.0rc1-9b7cfbc0cba.tar.gz
ZABBIX_VERSION=8.0.0rc1

# PostgreSQL
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_lab_change_me

# ClickHouse - Zabbix history + OpenTelemetry backend
CLICKHOUSE_DB=zabbix
CLICKHOUSE_USER=zabbix
CLICKHOUSE_PASSWORD=zabbix_clickhouse_change_me
CLICKHOUSE_HISTORY_TTL=2678400

# Zabbix
ZBX_SERVER_NAME=Zabbix 8 Lab
ZBX_LOGLEVEL=3
ZBX_STARTBROWSERPOLLERS=2
ZBX_STARTREPORTWRITERS=1

# Frontend
ZABBIX_WEB_PORT=8088

# OpenTelemetry
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Selenium
SELENIUM_PORT=4444
